#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# Pre-push Quality Gates - Full validation before push
echo "🚀 Running pre-push quality gates..."

# 1. Full test suite (coverage disabled due to minimatch dependency issue)
echo "\n🧪 Running full test suite..."
pnpm run test

# 2. Performance check (if built)
if [ -d "dist" ]; then
  echo "\n⚡ Checking bundle size..."
  pnpm run analyze:bundle
fi

# 3. Security audit
echo "\n🔒 Security audit..."
pnpm run security:audit

echo "\n✅ All pre-push gates passed! Ready to push."
echo "\n💡 Tip: Run 'pnpm run license:check' to audit licenses"

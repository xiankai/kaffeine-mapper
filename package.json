{
  "name": "kaffeine-mapper",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "vite preview --host 127.0.0.1 --port 3000 --strictPort",
    "test": "jest --config=jest.config.cjs",
    "test:coverage": "jest --config=jest.config.cjs --coverage",
    "test:watch": "jest --config=jest.config.cjs --watch",
    "test:changed": "jest --config=jest.config.cjs --bail --findRelatedTests --passWithNoTests",
    "lint:check": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "type-check": "tsc --noEmit",
    "imports:check": "eslint src/ --rule 'import-x/order: error' --rule 'import-x/no-cycle: error'",
    "analyze:bundle": "node scripts/check-bundle-size.js",
    "perf:audit": "pnpm dlx lighthouse http://localhost:3000 --view",
    "a11y:audit": "pnpm dlx lighthouse http://localhost:3000 --only-categories=accessibility --view",
    "security:audit": "pnpm audit --prod && pnpm audit --audit-level high",
    "license:check": "node scripts/check-licenses.js",
    "quality:all": "pnpm run lint:check && pnpm run type-check && pnpm run test:coverage && pnpm run security:audit && pnpm run license:check",
    "quality:fast": "pnpm run lint:check && pnpm run type-check && pnpm run test:changed",
    "prepare": "husky"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "leaflet": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.30.6",
    "@eslint/js": "^10.0.1",
    "@happy-dom/jest-environment": "^21.0.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.10",
    "@types/jest": "^29.5.14",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.0.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.4.6"
  }
}

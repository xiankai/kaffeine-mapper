{
  "name": "kaffeine-mapper",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "start": "vite preview --port 3000",
    "test": "jest --config=jest.config.cjs",
    "test:coverage": "jest --config=jest.config.cjs --coverage",
    "test:watch": "jest --config=jest.config.cjs --watch",
    "test:changed": "jest --config=jest.config.cjs --bail --findRelatedTests --passWithNoTests",
    "lint:check": "eslint src/ --ext .ts,.tsx,.js,.jsx --max-warnings 0",
    "lint:fix": "eslint src/ --ext .ts,.tsx,.js,.jsx --fix",
    "type-check": "tsc --noEmit",
    "imports:check": "eslint src/ --rule 'import/order: error' --rule 'import/no-cycle: error'",
    "build:analyze": "pnpm run build && pnpm exec vite-bundle-analyzer dist/",
    "analyze:bundle": "node scripts/check-bundle-size.js",
    "perf:audit": "pnpm dlx lighthouse http://localhost:3000 --view",
    "a11y:audit": "pnpm dlx lighthouse http://localhost:3000 --only-categories=accessibility --view",
    "security:audit": "pnpm audit",
    "security:scan": "pnpm exec snyk test",
    "security:deps": "pnpm exec audit-ci --moderate",
    "license:check": "license-checker --onlyAllow 'MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;Unlicense;MPL-2.0;UNLICENSED;LGPL-3.0-only' --production",
    "license:report": "license-report --output=html --only=prod > license-report.html",
    "quality:all": "pnpm run lint:check && pnpm run type-check && pnpm run test:coverage && pnpm run security:audit",
    "quality:fast": "pnpm run lint:check && pnpm run type-check && pnpm run test:changed",
    "prepare": "husky install",
    "postinstall": "husky install"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "date-fns": "^4.1.0",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@happy-dom/jest-environment": "^20.8.9",
    "@lhci/cli": "^0.12.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.8",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "audit-ci": "^6.6.1",
    "babel-plugin-istanbul": "^7.0.1",
    "eslint": "^8.55.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "eslint-plugin-security": "^1.7.1",
    "happy-dom": "^20.8.9",
    "husky": "^8.0.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "license-checker": "^25.0.1",
    "license-report": "^6.5.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.0",
    "rollup-plugin-analyzer": "^4.0.0",
    "snyk": "^1.1266.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2",
    "vite": "^5.4.21",
    "vite-bundle-analyzer": "^0.7.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged && pnpm run quality:fast",
      "pre-push": "pnpm run quality:all"
    }
  }
}

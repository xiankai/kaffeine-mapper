{
  "name": "kaffeine-mapper",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "vite preview --host 127.0.0.1 --port 3000 --strictPort",
    "test": "jest --config=jest.config.cjs",
    "test:coverage": "jest --config=jest.config.cjs --coverage",
    "test:watch": "jest --config=jest.config.cjs --watch",
    "test:changed": "jest --config=jest.config.cjs --bail --findRelatedTests --passWithNoTests",
    "lint:check": "eslint src/ --ext .ts,.tsx,.js,.jsx --max-warnings 0",
    "lint:fix": "eslint src/ --ext .ts,.tsx,.js,.jsx --fix",
    "type-check": "tsc --noEmit",
    "imports:check": "eslint src/ --rule 'import/order: error' --rule 'import/no-cycle: error'",
    "analyze:bundle": "node scripts/check-bundle-size.js",
    "perf:audit": "pnpm dlx lighthouse http://localhost:3000 --view",
    "a11y:audit": "pnpm dlx lighthouse http://localhost:3000 --only-categories=accessibility --view",
    "security:audit": "pnpm audit --prod && pnpm audit --audit-level high",
    "license:check": "node scripts/check-licenses.js",
    "quality:all": "pnpm run lint:check && pnpm run type-check && pnpm run test:coverage && pnpm run security:audit && pnpm run license:check",
    "quality:fast": "pnpm run lint:check && pnpm run type-check && pnpm run test:changed",
    "prepare": "husky"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@happy-dom/jest-environment": "^21.0.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.10",
    "@types/jest": "^29.5.14",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "lint-staged": "^17.0.0",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  }
}
